<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：状态卡与 Provider UID 校验需要查询目标应用。 -->
    <queries>
        <package android:name="com.netease.cloudmusic" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CloudMusicTool">

        <!--
            开关页把配置写进框架的 remote preferences。
            authority 必须是 <applicationId>.XposedService，这是 libxposed service 的约定；
            官方 XposedProvider 是 final 且其回调入口是包内可见，所以直接用它，不包一层。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 目标进程通过 call("report") 回写 Hook 健康度；provider 内校验调用方 UID。 -->
        <provider
            android:name=".StatusProvider"
            android:authorities="${applicationId}.status"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            MainActivity 同时承担两个入口：
            1. MODULE_SETTINGS：LSPosed 管理器里「打开」模块时使用；
            2. activity-alias LauncherEntry 的 targetActivity：桌面/抽屉图标。
            桌面图标单独由 alias 承载，隐藏图标只要禁用 alias，MainActivity 本身仍在，
            所以不会出现「隐藏后连设置页都打不开」的自锁。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口。name 用完整类名（按 namespace 解析），代码侧 LauncherIcon 里同名字符串。 -->
        <activity-alias
            android:name="com.cloudmusictool.app.LauncherEntry"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
