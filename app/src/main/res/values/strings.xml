    <!-- AD 广告净化 -->
    <string name="f_ad_01_title">开屏广告跳过</string>
    <string name="f_ad_01_summary">拦截开屏广告展示与落地页，摇一摇跳转一并失效；广告请求仍会发出</string>
    <string name="f_ad_02_title">运营弹窗屏蔽</string>
    <string name="f_ad_02_summary">屏蔽启动时的运营与营销弹窗，登录弹窗保留</string>
    <string name="f_ad_08_title">广告上报与外跳拦截</string>
    <string name="f_ad_08_summary">阻断广告统计上报与静默拉起外部应用，正常分享跳转不受影响</string>
    <string name="f_ad_09_title">搜索广告净化</string>
    <string name="f_ad_09_summary">清空搜索起始页广告位，并移除搜索结果中的大图与中图广告</string>
    <string name="f_ad_10_title">广告预加载裁剪</string>
    <string name="f_ad_10_summary">跳过冷启动广告入口与播客激励广告预加载，减少无效网络与内存占用</string>
    <string name="f_ad_04_title">首页信息流广告</string>
    <string name="f_ad_04_summary">移除发现页与推荐流中的推广卡片，布局自适应留空</string>
    <string name="f_ad_05_title">评论区广告</string>
    <string name="f_ad_05_summary">移除评论区广告横幅、推广组件与带货标签</string>
    <string name="f_ad_06_title">播放页广告</string>
    <string name="f_ad_06_summary">移除黑胶界面的广告层、送礼与推广贴纸</string>
    <string name="f_ad_07_title">音频贴片广告</string>
    <string name="f_ad_07_summary">拦截音频起播贴片与播客内插广告，播放进度不受影响</string>

    <!-- UI 界面精简 -->
    <string name="f_ad_03_title">更新弹窗屏蔽</string>
    <string name="f_ad_03_summary">屏蔽版本检查、强制更新弹窗与应用内下载入口，不改变已安装版本</string>
    <string name="f_ui_05_title">跳过启动延迟</string>
    <string name="f_ui_05_summary">去掉启动时的红屏人为等待，冷启动更快；异常时可能提前进入首页</string>
    <string name="f_ui_01_title">首页模块净化</string>
    <string name="f_ui_01_summary">按模块代码隐藏发现页推荐卡片，并同步过滤首页缓存</string>
    <string name="f_ui_02_title">顶部频道管理</string>
    <string name="f_ui_02_summary">按保留清单删除顶部频道与对应页面，至少保留 1 个；留空显示全部</string>
    <string name="f_ui_03_title">底部导航精简</string>
    <string name="f_ui_03_summary">按保留清单精简底部导航；首页 Tab 始终保留，避免主页面无法初始化</string>
    <string name="f_ui_04_title">侧栏抽屉精简</string>
    <string name="f_ui_04_summary">暂不支持：9.6.08 未找到可靠的抽屉数据挂载点</string>
    <string name="f_ui_06_title">引导与气泡屏蔽</string>
    <string name="f_ui_06_summary">屏蔽引导气泡、评分弹窗与青少年弹窗，不影响登录与实名流程</string>
    <string name="f_ui_07_title">禁止自动播放</string>
    <string name="f_ui_07_summary">禁止冷启动、信息流与切歌时自动播放，手动播放不受影响</string>
    <string name="f_ui_09_title">关闭头像挂件</string>
    <string name="f_ui_09_summary">屏蔽个人主页与评论区头像挂件，仅影响展示</string>
    <string name="f_ui_10_title">播放页提示治理</string>
    <string name="f_ui_10_summary">关闭播放页评论气泡、推荐提示与卡顿弹窗，异常诊断信息随之隐藏</string>
    <string name="f_ui_11_title">搜索热词轮播</string>
    <string name="f_ui_11_summary">关闭搜索框内的运营热词轮播，搜索功能保持可用</string>
    <string name="f_ui_12_title">播客与 AI DJ 引导</string>
    <string name="f_ui_12_summary">关闭 FM 自动播放、听书权益与 AI DJ 切换引导，不改变已订阅内容</string>
    <string name="f_ui_13_title">小组件与推送引导</string>
    <string name="f_ui_13_summary">关闭添加小组件与推送引导弹窗，不影响系统通知权限</string>
    <string name="f_ui_14_title">歌词页推广</string>
    <string name="f_ui_14_summary">关闭歌词页底部推广、选项气泡与歌词视频弹窗</string>
    <string name="f_ui_15_title">云村与直播推广</string>
    <string name="f_ui_15_summary">关闭直播间推广位与云村发布、搜索引导气泡，直播功能本身保留</string>

    <!-- PV 隐私保护 -->
    <string name="f_pv_01_title">OAID 与设备追踪拦截</string>
    <string name="f_pv_01_summary">阻断 OAID 上传链路与相关启动任务，可能影响依赖设备标识的统计</string>
    <string name="f_pv_02_title">日志写盘任务屏蔽</string>
    <string name="f_pv_02_summary">屏蔽日志落盘任务，减少磁盘写入；崩溃日志可能不再完整</string>
    <string name="f_pv_03_title">启动任务黑名单</string>
    <string name="f_pv_03_summary">跳过启动黑名单中的非必要任务与追踪组件，可能延后部分初始化</string>
    <string name="f_pv_04_title">APM 上报抑制</string>
    <string name="f_pv_04_summary">抑制 APM 性能数据上报与后台上传，不影响崩溃捕获</string>
    <string name="f_pv_05_title">统计数据上报抑制</string>
    <string name="f_pv_05_summary">记录统计上报调用并关闭监控开关，仅抑制上报不阻断业务</string>
    <string name="f_pv_06_title">剪贴板读取拦截</string>
    <string name="f_pv_06_summary">阻断全局剪贴板读取，避免启动时识别口令与深链；粘贴功能可能受影响</string>

    <!-- EN 功能增强 -->
    <string name="f_ui_16_title">我的页自定义背景</string>
    <string name="f_ui_16_summary">在「我的」页显示本地图片全屏背景，仅本机可见；不改变会员状态</string>

    <!-- EX 实验功能 -->
    <string name="f_ui_08_title">强制深色模式（实验性）</string>
    <string name="f_ui_08_summary">强制开启夜间深色主题，可能与宿主主题资源冲突（实验性）</string>
    <string name="f_pv_07_title">启动任务编排</string>
    <string name="f_pv_07_summary">调整白名单启动任务的优先级与线程，可能改变启动顺序（实验性）</string>

